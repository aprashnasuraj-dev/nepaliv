# ---------- general ----------
APP_ENV=prod
PUBLIC_BASE_URL=https://api.yourapp.com      # used for local file URLs
API_KEYS=change-me-1,change-me-2               # empty = open API (dev only!)
CORS_ORIGINS=https://yourapp.com
DATA_DIR=/data                                 # voicebank + local songs; mount a volume here
VOICES_DIR=/app/voices

# ---------- queue ----------
# Empty REDIS_URL => jobs run in-process (single box, single uvicorn worker).
REDIS_URL=redis://redis:6379/0
INLINE_WORKERS=1
JOB_TIMEOUT_S=600
RATE_LIMIT_PER_HOUR=10

# ---------- storage ----------
STORAGE_BACKEND=local                          # local | s3
# Cloudflare R2 (S3 API, free egress):
S3_BUCKET=nepali-songs
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://songs.yourapp.com   # R2 custom domain / r2.dev URL; empty => presigned URLs

# ---------- lyrics LLMs (free tiers, tried in order) ----------
LLM_PROVIDERS=gemini,groq,openrouter,local
GEMINI_API_KEY=                                # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash                  # check current free-tier model names
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LOCAL_LLM_BASE_URL=                            # e.g. http://llm:8080/v1 (llama.cpp server)
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# ---------- voice / audio ----------
TTS_ENGINE=piper
DEFAULT_VOICE=ne_NP-chitwan-medium          # male, CC0; ne_NP-google-medium = female
TTS_THREADS=2
MP3_BITRATE=160k
SOUNDFONT_PATH=                                # optional /app/assets/GeneralUser.sf2 (+ apt fluidsynth)
